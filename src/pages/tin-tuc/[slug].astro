
---
export async function getStaticPaths() {
  const response = await fetch(
    'https://cms.fuchi.vn/wp-json/wp/v2/posts?per_page=100&_embed'
  );

  if (!response.ok) {
    throw new Error('Không lấy được bài viết WordPress');
  }

  const posts = await response.json();

  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = post.title.rendered.replace(/<[^>]*>/g, '');

const featuredImage =
  post._embedded?.['wp:featuredmedia']?.[0]?.source_url || null;

const publishedDate = new Date(post.date).toLocaleDateString('vi-VN');
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | FUCHI</title>
  <meta name="description" content={post.excerpt.rendered.replace(/<[^>]*>/g, '').trim()} />
<style is:global>
  .content figcaption,
  .content .wp-element-caption,
  .content .wp-caption-text,
  .content .has-text-align-center {
    text-align: center;
  }

  .content figure.aligncenter {
    margin-left: auto;
    margin-right: auto;
  }
</style>
</head>

<body>
  <header>
    <a href={`${base}/`} class="brand">FUCHI</a>
    <nav>
      <a href={`${base}/`}>Trang chủ</a>
      <a href={`${base}/tin-tuc`}>Tin tức & tư vấn</a>
    </nav>
  </header>

  <main>
    <article>
      <a class="back" href={`${base}/tin-tuc`}>
        ← Tin tức & tư vấn
      </a>

      <h1>{title}</h1>

      <p class="date">{publishedDate}</p>

      {featuredImage && (
        <img class="featured" src={featuredImage} alt={title} />
      )}

      <div class="content" set:html={post.content.rendered} />
    </article>
  </main>

  <footer>© {new Date().getFullYear()} FUCHI – Ngói Việt Nhật</footer>
</body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #20372e;
    font-family: Arial, sans-serif;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 5%;
    background: #fff;
  }

  .brand {
    font-size: 30px;
    font-weight: bold;
    color: #b43b32;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    max-width: 900px;
    margin: 65px auto;
    padding: 0 24px;
  }

  article {
    background: white;
    padding: 45px;
  }

  h1 {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.3;
  }

  .date {
    color: #777;
  }

  .back {
    color: #b43b32;
  }

  .featured {
    width: 100%;
    height: auto;
    margin: 30px 0;
  }

  .content {
    font-size: 18px;
    line-height: 1.85;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
  }

  footer {
    text-align: center;
    padding: 30px;
    background: #20372e;
    color: white;
  }
</style>
