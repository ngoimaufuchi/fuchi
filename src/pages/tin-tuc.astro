.header-logo img{width:82px;height:82px;object-fit:contain}
.header-inner{gap:20px}
.header nav{gap:24px;margin-right:8px}
.header nav a{white-space:nowrap}
.header-cta{white-space:nowrap;flex-shrink:0}
@media(min-width:601px) and (max-width:1100px){
  .header-inner{height:92px;gap:16px}
  .header-cta{margin-left:auto}
  .menu-button{width:36px;height:40px;display:flex;flex-direction:column;justify-content:center;gap:6px;background:none;border:0;padding:5px}
  .menu-button span{height:1px;background:var(--ink);width:24px}
  .header nav{display:none;position:absolute;top:92px;left:0;right:0;flex-direction:column;padding:20px;background:white;border-bottom:1px solid var(--line);margin:0;gap:0}
  .header nav.is-open{display:flex}
  .header nav a{padding:12px;font-size:16px}
}
@media(max-width:600px){
  .header-inner{height:72px;gap:8px}
  .header-brands{gap:6px}
  .header-logo img{width:48px;height:48px}
  .header-cta{padding:8px 10px;gap:8px}
  .menu-button{flex-shrink:0}
}
@media(max-width:420px){
  .header-cta{display:none}
  .menu-button{margin-left:auto}
  .header-logo img{width:54px;height:54px}
}
    
.news-intro{background:#f5f3ed}.news-panel{display:grid;grid-template-columns:1.1fr 1fr;gap:72px;align-items:center}.news-panel h2{margin:14px 0 20px}.news-description{max-width:480px;color:var(--muted);margin-bottom:28px;line-height:1.8}.news-topics>div{position:relative;padding:20px 0 20px 48px;border-bottom:1px solid #d9ddd6}.news-topics>div:first-child{border-top:1px solid #d9ddd6}.news-topics span{position:absolute;left:0;top:23px;color:var(--red);font-weight:700}.news-topics h3{font:700 20px Arial,sans-serif;margin-bottom:6px}.news-topics p{font-size:14px;color:var(--muted)}
@media(min-width:1101px){.header-inner{height:auto;min-height:104px;flex-wrap:wrap;padding-block:8px;gap:10px 20px}.header nav{gap:18px;margin-right:0}.header nav a{font-size:15px}.header-cta{padding-inline:16px;gap:12px}}
@media(max-width:850px){.news-panel{grid-template-columns:1fr;gap:28px}}

.header nav a[aria-current="page"]{color:var(--red)}.news-hero{background:#f5f3ed;padding:44px 0 60px;border-bottom:1px solid var(--line)}.breadcrumb{display:inline-block;font-size:13px;color:var(--muted);margin-bottom:34px}.news-hero h1{font:700 clamp(42px,5vw,68px)/1.15 Arial,sans-serif;margin:18px 0 24px}.news-hero h1 em{font-style:normal;color:var(--red)}.news-lead{max-width:620px;font-size:18px;color:var(--muted)}.topic-labels{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.topic-labels span{border:1px solid #d5dcd5;border-radius:30px;padding:8px 16px;font-size:13px;background:#fff}.news-list-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:30px}.news-list-heading>span{font-size:14px;color:var(--muted)}.news-empty{border:1px solid var(--line);padding:48px 30px;text-align:center;background:#fafbf8}.empty-mark{display:flex;width:56px;height:56px;margin:0 auto 20px;align-items:center;justify-content:center;background:var(--ink);color:white;font-weight:700;font-size:28px}.news-empty h3{font:700 26px/1.4 Arial,sans-serif;max-width:600px;margin:0 auto 14px}.news-empty p{max-width:600px;margin:0 auto 24px;color:var(--muted)}.news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.news-card{border:1px solid var(--line);background:#fff}.news-card>a{display:block;height:100%}.news-card img{width:100%;aspect-ratio:16/10;object-fit:cover}.news-card-body{padding:24px}.news-card time{display:block;color:var(--muted);font-size:12px;margin:8px 0}.news-card h3{font:700 23px/1.4 Arial,sans-serif;margin:12px 0}.news-card-body>p:not(.eyebrow){color:var(--muted);font-size:14px}.read-more{display:inline-block;margin-top:20px;font-weight:700;color:var(--red)}.news-card a:hover h3{color:var(--red)}
@media(max-width:850px){.news-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.news-hero{padding:28px 0 40px}.news-lead{font-size:16px}.news-grid{grid-template-columns:1fr}.news-empty{padding:32px 20px}.news-empty h3{font-size:22px}.topic-labels span{font-size:12px;padding:7px 12px}}
</style><script>
  const filters = document.querySelectorAll<HTMLElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.news-card[data-category]');
  const counter = document.querySelector<HTMLElement>('.news-list-heading span');
const emptyMessage = document.createElement('p');
emptyMessage.textContent =
  'Chuyên mục này hiện chưa có bài viết. FUCHI sẽ sớm cập nhật nội dung.';
emptyMessage.style.cssText =
  'padding:24px 0;color:#666;font-size:16px;';
emptyMessage.setAttribute('role', 'status');
emptyMessage.hidden = true;

document.querySelector('.news-grid')?.after(emptyMessage);
  let activeFilter = '';

  function applyFilter(category: string) {
    activeFilter = activeFilter === category ? '' : category;
    let visibleCount = 0;

    cards.forEach((card) => {
      const visible =
        !activeFilter || card.dataset.category === activeFilter;

      card.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    filters.forEach((filter) => {
      const selected = filter.dataset.filter === activeFilter;
      filter.setAttribute('aria-pressed', String(selected));
      filter.style.fontWeight = selected ? '700' : '';
    });

    if (counter) {
      counter.textContent = `${visibleCount} bài viết`;
    }
    emptyMessage.hidden = visibleCount !== 0;
  }

  filters.forEach((filter) => {
    filter.style.cursor = 'pointer';
    filter.setAttribute('aria-pressed', 'false');

    filter.addEventListener('click', () => {
      applyFilter(filter.dataset.filter || '');
    });

    filter.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        applyFilter(filter.dataset.filter || '');
      }
    });
  });
</script></body></html>