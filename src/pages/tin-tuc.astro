---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (name: string) => `${base}/images/${name}`;
// Kết nối WordPress FUCHI
const wordpressApi = 'https://cms.fuchi.vn/wp-json/wp/v2/posts?per_page=10&_embed';

let wordpressPosts: any[] = [];

try {
  const response = await fetch(wordpressApi);

  if (!response.ok) {
    throw new Error(`HTTP ${response.status}`);
  }

  wordpressPosts = await response.json();

  console.log(`WordPress: Đã lấy ${wordpressPosts.length} bài viết`);
} catch (error) {
  console.error('Lỗi kết nối WordPress:', error);
}
// Các bài Markdown trong src/pages/tin-tuc/ sẽ tự xuất hiện tại đây sau khi build.
const modules = import.meta.glob('./tin-tuc/*.md', { eager: true }) as Record<string, {frontmatter: Record<string, any>}>;
// Giữ lại các bài viết cũ
const localPosts = Object.entries(modules)
  .filter(([, post]) => post.frontmatter.title && !post.frontmatter.draft)
  .map(([path, post]) => ({
    ...post.frontmatter,
    href: `${base}/tin-tuc/${path.split('/').pop()!.replace(/\.md$/, '')}/`
  }));

// Chuyển dữ liệu WordPress sang định dạng FUCHI
const wpPosts = wordpressPosts.map((post) => {
  const excerpt = (post.excerpt?.rendered || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  return {
    title: (post.title?.rendered || 'Bài viết FUCHI')
      .replace(/<[^>]*>/g, '')
      .replace(/&amp;/g, '&'),
    date: post.date,
    excerpt,
    description: excerpt,
    image:
      post._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
      '/images/logo1.jpg',
    category:
  post.categories?.includes(3) ? 'Kinh nghiệm chọn ngói' :
  post.categories?.includes(4) ? 'Thi công & bảo dưỡng' :
  post.categories?.includes(5) ? 'Công trình thực tế' :
  post.categories?.includes(6) ? 'Tin FUCHI' :
  'Tin tức',
    href: `${base}/tin-tuc/${post.slug}/`
  };
});

// Kết hợp bài viết WordPress và bài viết cũ
const posts = [...wpPosts, ...localPosts]
  .sort((a, b) =>
    new Date(b.date || 0).getTime() -
    new Date(a.date || 0).getTime()
  );
const dateLabel = (date: string) => { const value = new Date(date); return Number.isNaN(value.getTime()) ? '' : value.toLocaleDateString('vi-VN'); };
